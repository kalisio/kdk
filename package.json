{
  "name": "@kalisio/kdk",
  "description": "Kalisio Development Kit",
  "version": "2.7.0",
  "homepage": "https://github.com/kalisio/kdk",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "keywords": [
    "Kalisio",
    "KDK"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/kalisio/kdk.git"
  },
  "author": {
    "name": "Kalisio contributors",
    "url": "https://github.com/kalisio/kdk"
  },
  "contributors": [],
  "bugs": {
    "url": "https://github.com/kalisio/kdk/issues"
  },
  "engines": {
    "node": ">= 16.0.0"
  },
  "scripts": {
    "publish": "git push origin --tags && git push origin",
    "release:patch": "npm version --force patch && echo '//registry.npmjs.org/:_authToken=${NPM_TOKEN}' > .npmrc.publish && npm publish --userconfig .npmrc.publish --access public; rm -f .npmrc.publish",
    "release:minor": "npm version --force minor && echo '//registry.npmjs.org/:_authToken=${NPM_TOKEN}' > .npmrc.publish && npm publish --userconfig .npmrc.publish --access public; rm -f .npmrc.publish",
    "release:major": "npm version --force major && echo '//registry.npmjs.org/:_authToken=${NPM_TOKEN}' > .npmrc.publish && npm publish --userconfig .npmrc.publish --access public; rm -f .npmrc.publish",
    "lint:core": "standard core/**/*.js core/**/*.vue --fix",
    "lint:map": "standard map/**/*.js map/**/*.vue --fix",
    "lint:test:api": "standard test/api/core/**/*.js test/api/map/**/*.js --fix",
    "lint:test:client": "standard extras/tests/core/**/*.mjs extras/tests/map/**/*.mjs --fix",
    "lint": "npm-run-all --serial lint:**",
    "mocha:core": "cross-env NODE_CONFIG_DIR=./test/api/core/config/ mocha test/api/core/**/*.test.js --exit",
    "mocha:map": "cross-env NODE_CONFIG_DIR=./test/api/map/config/ mocha test/api/map/**/*.test.js --exit",
    "mocha": "npm-run-all --serial mocha:**",
    "coverage": "c8 npm run mocha",
    "test:client": "cd vite && yarn test:core",
    "test": "npm run lint && npm run coverage && npm run test:client"
  },
  "standard": {
    "parser": "vue-eslint-parser",
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": "latest"
    },
    "plugins": [
      "vue"
    ],
    "env": [
      "mocha"
    ],
    "globals": [
      "DEV",
      "PROD",
      "addEventListener",
      "cordova",
      "location",
      "FileReader",
      "LocalFileSystem",
      "mime",
      "atob",
      "URL",
      "Blob",
      "Event",
      "MouseEvent",
      "AbortController",
      "localStorage",
      "DOMParser",
      "caches",
      "MutationObserver",
      "DataTransfer",
      "DragEvent"
    ]
  },
  "directories": {
    "core": "./core",
    "map": "./map",
    "test": "./test",
    "extras": "./extras",
    "docs": "./docs"
  },
  "dependencies": {
    "@casl/ability": "^6.1.1",
    "@casl/mongoose": "^7.1.0",
    "@feathersjs/authentication": "~5.0.44",
    "@feathersjs/authentication-local": "~5.0.44",
    "@feathersjs/authentication-oauth": "~5.0.44",
    "@feathersjs/configuration": "~5.0.44",
    "@feathersjs/errors": "~5.0.44",
    "@feathersjs/express": "~5.0.44",
    "@feathersjs/feathers": "~5.0.44",
    "@feathersjs/mongodb": "~5.0.44",
    "@feathersjs/schema": "~5.0.44",
    "@feathersjs/socketio": "~5.0.44",
    "@kalisio/common-core": "~0.11.0",
    "@kalisio/feathers-import-export": "~3.0.0",
    "@kalisio/feathers-mongodb-management": "~3.0.0",
    "@kalisio/feathers-s3": "~3.0.0",
    "@kalisio/feathers-webpush": "~3.0.0",
    "@mapbox/sphericalmercator": "^1.2.0",
    "@turf/bbox": "^6.0.1",
    "@weacast/core": "^2.2.1",
    "abort-controller": "^3.0.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "compression": "^1.6.2",
    "cors": "~2.8.6",
    "cron": "~4.4.0",
    "debug": "~4.4.3",
    "ejs": "~5.0.1",
    "email-templates": "^2.7.1",
    "express-rate-limit": "^5.1.0",
    "feathers-authentication-management": "~4.0.0",
    "feathers-hooks-common": "~8.2.1",
    "feathers-mailer": "~3.0.0",
    "feathers-mongodb": "^6.4.1",
    "feathers-mongodb-fuzzy-search": "~2.0.1",
    "geotiff": "^2.1.3",
    "helmet": "~8.3.0",
    "jsdap": "^8.1.0",
    "limiter": "^1.1.3",
    "localforage": "^1.3.0",
    "lodash": "~4.18.1",
    "lodash-es": "~4.18.1",
    "lru-cache": "~11.5.2",
    "mathjs": "^15.2.0",
    "minimatch": "^10.0.1",
    "moment": "~2.30.1",
    "mongodb": "~6.20.0",
    "papaparse": "~5.7.0",
    "password-generator": "^2.3.2",
    "password-validator": "^4.0.0",
    "qs": "^6.15.3",
    "sanitize-html": "~2.17.4",
    "sift": "~17.1.3",
    "superagent": "~10.3.0",
    "winston": "~3.19.0",
    "winston-daily-rotate-file": "~4.7.1",
    "xml2js": "~0.6.2"
  },
  "resolutions": {
    "typed-function": "4.1.1"
  },
  "devDependencies": {
    "@feathersjs/authentication-client": "^5.0.8",
    "@feathersjs/memory": "^5.0.8",
    "@kalisio/feathers-distributed": "^2.4.0",
    "@turf/intersect": "^6.1.3",
    "@weacast/gfs": "^2.2.1",
    "@weacast/probe": "^2.2.1",
    "body-parser": "^1.17.1",
    "c8": "^7.11.0",
    "chai": "^4.2.0",
    "chai-lint": "^0.1.1",
    "chai-spies": "^0.7.1",
    "config": "~4.4.1",
    "cross-env": "^5.2.0",
    "eslint-plugin-vue": "^9.26.0",
    "esm": "^3.2.25",
    "express": "^5.2.1",
    "fs-extra": "^8.1.0",
    "googleapis": "^21.3.0",
    "is-docker": "~2.2.1",
    "mocha": "^9.1.1",
    "nock": "^14.0.5",
    "npm-run-all": "^4.1.1",
    "pngjs": "^5.0.0",
    "sass-embedded": "^1.32.12",
    "shx": "^0.3.2",
    "standard": "^17.1.2"
  }
}