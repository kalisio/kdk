    "node": ">= 16.0.0"
  },
  "scripts": {
    "publish": "git push origin --tags && git push origin",
    "release:patch": "pnpm version --force patch && echo '//registry.npmjs.org/:_authToken=${NPM_TOKEN}' > .npmrc.publish && npm publish --userconfig .npmrc.publish --access public; rm -f .npmrc.publish",
    "release:minor": "pnpm version --force minor && echo '//registry.npmjs.org/:_authToken=${NPM_TOKEN}' > .npmrc.publish && npm publish --userconfig .npmrc.publish --access public; rm -f .npmrc.publish",
    "release:major": "pnpm version --force major && echo '//registry.npmjs.org/:_authToken=${NPM_TOKEN}' > .npmrc.publish && npm publish --userconfig .npmrc.publish --access public; rm -f .npmrc.publish",
    "docs:build": "cd docs && pnpm install --ignore-workspace && pnpm build",
    "lint:core": "standard core/**/*.js core/**/*.vue --fix",
    "lint:map": "standard map/**/*.js map/**/*.vue --fix",
    "lint:test:api": "standard test/api/core/**/*.js test/api/map/**/*.js --fix",
    "lint:test:client": "standard extras/tests/core/**/*.mjs extras/tests/map/**/*.mjs --fix",
    "lint:test": "pnpm run lint:test:api && pnpm run lint:test:client",
    "lint": "pnpm run lint:core && pnpm run lint:map && pnpm run lint:test",
    "mocha:core": "cross-env NODE_OPTIONS=--conditions=development NODE_CONFIG_DIR=./test/api/core/config/ mocha test/api/core/**/*.test.js --exit",
    "mocha:map": "cross-env NODE_OPTIONS=--conditions=development NODE_CONFIG_DIR=./test/api/map/config/ mocha test/api/map/**/*.test.js --exit",
    "mocha": "pnpm run mocha:core && pnpm run mocha:map",
    "coverage": "c8 pnpm run mocha",
    "test:client": "cd vite && pnpm test:core",
    "test": "pnpm run lint && pnpm run coverage"
  },
  "standard": {
    "parser": "vue-eslint-parser",
    "parserOptions": {
      "sourceType": "module",
      "ecmaVersion": "latest"
    },
    "plugins": [
      "vue"
    ],
    "env": [
      "mocha"
    ],
    "globals": [
      "DEV",
      "PROD",
      "addEventListener",
      "cordova",
      "location",
      "FileReader",
      "LocalFileSystem",
      "mime",
      "atob",
      "URL",
      "Blob",
      "Event",
      "MouseEvent",
      "AbortController",
      "localStorage",
      "DOMParser",
      "caches",
      "MutationObserver",
      "DataTransfer",
      "DragEvent"
    ]
  },
  "directories": {
    "core": "./core",
    "map": "./map",
    "test": "./test",
    "extras": "./extras",
    "docs": "./docs"
  },
